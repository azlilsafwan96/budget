DATABASE_URL="postgresql://budget:budget@localhost:5432/budget?schema=public"
AUTH_SECRET="generate-with: openssl rand -base64 32"

# Required in prod (behind a reverse proxy) so NextAuth doesn't infer the
# base URL from request headers, which can end up as the container's
# internal localhost:3000 if the proxy doesn't forward Host correctly.
# AUTH_URL="https://YOUR_DOMAIN"

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (dev)
#                           https://YOUR_DOMAIN/api/auth/callback/google (prod)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
